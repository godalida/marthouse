# Copy to docker/.env and fill in. Never commit the real file.
POSTGRES_PASSWORD=change-me
# Encrypts warehouse passwords and Git tokens. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MARTHOUSE_SECRET_KEY=
# Port on this machine for the web app
MARTHOUSE_PORT=8765
MARTHOUSE_PUBLIC_URL=http://localhost:8765
MARTHOUSE_COOKIE_SECURE=false
# Optional: JSON feed {"version": "0.2.0", "url": "https://..."} for the Updates tab
MARTHOUSE_UPDATE_FEED_URL=
